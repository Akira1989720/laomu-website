---
// 案例內頁：/works/網址代稱/
// 每一份案例資料（src/content/works/*.md）會自動產生一頁。
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Contact from '../../components/Contact.astro';
import { asset, url } from '../../lib/paths.js';
import { getSortedWorks, workUrl } from '../../lib/works.js';
import { youtubeId } from '../../lib/youtube.js';

export async function getStaticPaths() {
  const works = await getSortedWorks();
  // 上一個／下一個：依作品列表的順序（年份由新到舊）
  return works.map((work, i) => ({
    params: { id: work.id },
    props: { work, prev: works[i - 1] ?? null, next: works[i + 1] ?? null },
  }));
}

const { work, prev, next } = Astro.props;
const d = work.data;
const { Content } = await render(work);
const videoId = youtubeId(d.video);
const listUrl = url('works/');
---
<BaseLayout title={`${d.title}｜荖慕工作室有限公司`} description={d.summary}>
  <div class="shell">
  <article class="case-page" aria-labelledby="case-title">
    <nav class="breadcrumb" aria-label="目前位置">
      <ol><li><a href={url('')}>首頁</a></li><li><a href={listUrl} data-back-to-list>專案作品</a></li><li aria-current="page">{d.title}</li></ol>
    </nav>

    <header class="case-head">
      <p class="project-type">{d.category}｜{d.year}</p>
      <h1 id="case-title" class="case-title">{d.title}</h1>
      <p class="case-summary">{d.summary}</p>
    </header>

    <figure class="case-cover project-media">
      <img src={asset(d.cover)} alt={d.coverAlt} width="1300" height="855" fetchpriority="high">
    </figure>

    <div class="case-layout">
      <dl class="case-info">
        <div><dt>類型</dt><dd>{d.category}</dd></div>
        <div><dt>年份</dt><dd>{d.year}</dd></div>
        {d.client && <div><dt>主辦／委託</dt><dd>{d.client}</dd></div>}
        {d.location && <div><dt>地點</dt><dd>{d.location}</dd></div>}
        {d.scope.length > 0 && <div><dt>負責範圍</dt><dd>{d.scope.join('、')}</dd></div>}
      </dl>
      <div class="case-body">
        <Content />
      </div>
    </div>

    {d.video && (
      <section class="case-section" aria-labelledby="case-video-title">
        <h2 id="case-video-title" class="eyebrow">VIDEO<span class="slash">/</span>活動影片</h2>
        {videoId ? (
          <div class="case-video">
            <iframe src={`https://www.youtube-nocookie.com/embed/${videoId}`} title={`${d.title}｜活動影片`} loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
          </div>
        ) : (
          <p><a class="text-link" href={d.video} target="_blank" rel="noopener noreferrer">到 YouTube 觀看影片（另開新分頁）</a></p>
        )}
      </section>
    )}

    {d.gallery.length > 0 && (
      <section class="case-section" aria-labelledby="case-gallery-title">
        <h2 id="case-gallery-title" class="eyebrow">ON SITE<span class="slash">/</span>現場照片</h2>
        <div class="case-gallery">
          {d.gallery.map((g) => (
            <figure data-reveal>
              <div class="project-media"><img src={asset(g.image)} alt={g.caption ?? ''} width="650" height="428" loading="lazy" decoding="async"></div>
              {g.caption && <figcaption>{g.caption}</figcaption>}
            </figure>
          ))}
        </div>
      </section>
    )}

    <nav class="case-nav" aria-label="其他案例">
      <div class="case-nav-prev">
        {prev && <a href={workUrl(prev)}><span class="case-nav-label">← 上一個案例</span><span class="case-nav-title">{prev.data.title}</span></a>}
      </div>
      <a class="text-link case-nav-back" href={listUrl} data-back-to-list>回到作品列表</a>
      <div class="case-nav-next">
        {next && <a href={workUrl(next)}><span class="case-nav-label">下一個案例 →</span><span class="case-nav-title">{next.data.title}</span></a>}
      </div>
    </nav>
  </article>
  </div>
  <Contact />
</BaseLayout>

<script>
  // 如果是從作品列表點進來的，「回到作品列表」會回到原本的篩選結果（例如只看政府標案）。
  const listPath = new URL(document.querySelector<HTMLAnchorElement>('[data-back-to-list]')!.href).pathname;
  try {
    const from = new URL(document.referrer);
    if (from.origin === location.origin && from.pathname === listPath) {
      document.querySelectorAll<HTMLAnchorElement>('[data-back-to-list]').forEach((a) => { a.href = from.href; });
    }
  } catch { /* 直接打開網址時沒有來源頁，維持預設連結 */ }
</script>
