---
// 首頁「精選現場」：1 個大案例＋3 個小案例。
// 目前案名、類型、負責範圍都是「待補」，之後會改由後台編輯。
import { img } from '../lib/paths.js';
---
<div class="section-band band-works"><div class="shell">
<section class="works" id="works" aria-labelledby="works-title">
  <div class="section-heading">
    <div><p class="eyebrow">PROJECT ARCHIVE<span class="slash">/</span>專案作品</p><h2 id="works-title">精選現場</h2></div>
    <div class="filters" aria-label="案例分類尚待確認">
      <span class="filter current" aria-current="true">全部</span><span class="filter" aria-disabled="true" title="案例類型待補，暫未開放篩選">政府標案</span><span class="filter" aria-disabled="true" title="案例類型待補，暫未開放篩選">企業專案</span>
    </div>
  </div>
  <div class="works-grid">
    <article class="featured" data-reveal aria-label="精選現場一，案名待補">
      <div class="project-media"><img class="featured-photo" src={img('works-01.jpg')} alt="戶外歌仔戲演出，觀眾面向傳統彩繪戲台欣賞表演" width="1300" height="867" loading="lazy" decoding="async"></div>
      <div class="project-copy"><p class="project-type">類型｜待補</p><h3>待補</h3><p class="project-scope">負責範圍｜待補</p></div>
    </article>
    <div class="work-list">
      <article class="work-row" data-reveal aria-label="精選現場二，案名待補"><div class="project-media"><img src={img('works-02.jpg')} alt="藝術節觀眾坐在草地上，專注欣賞演出" width="650" height="434" loading="lazy" decoding="async"></div><div class="project-copy"><p class="project-type">類型｜待補</p><h3>待補</h3><p class="project-scope">負責範圍｜待補</p></div></article>
      <article class="work-row" data-reveal aria-label="精選現場三，案名待補"><div class="project-media"><img src={img('works-03.jpg')} alt="古蹟走讀參與者在廟宇前合影" width="650" height="488" loading="lazy" decoding="async"></div><div class="project-copy"><p class="project-type">類型｜待補</p><h3>待補</h3><p class="project-scope">負責範圍｜待補</p></div></article>
      <article class="work-row" data-reveal aria-label="精選現場四，案名待補"><div class="project-media"><img src={img('works-04.jpg')} alt="由高處俯瞰戶外公演，觀眾整齊聚集在體育場草地" width="650" height="433" loading="lazy" decoding="async"></div><div class="project-copy"><p class="project-type">類型｜待補</p><h3>待補</h3><p class="project-scope">負責範圍｜待補</p></div></article>
    </div>
  </div>
  <div class="all-projects"><span class="text-link" aria-disabled="true" title="完整專案列表待補">查看全部專案</span></div>
</section>
</div></div>
