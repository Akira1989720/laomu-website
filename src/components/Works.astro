---
// 首頁「精選現場」：自動顯示勾選「首頁精選」的案例（最多 4 個，依年份由新到舊）。
// 第 1 個是大卡片，其餘是右側的小卡片。點卡片會進入案例內頁。
// 如果沒有任何案例勾選「首頁精選」，就改為顯示最新的 4 個案例，避免區塊空白。
// 篩選標籤會跳到作品列表頁，並自動套用該分類。
import { asset, url } from '../lib/paths.js';
import { categories, getSortedWorks, workUrl } from '../lib/works.js';

const all = await getSortedWorks();
const picked = all.filter((w) => w.data.featured);
const featured = (picked.length > 0 ? picked : all).slice(0, 4);
const [lead, ...rest] = featured;
---
<div class="section-band band-works"><div class="shell">
<section class="works" id="works" aria-labelledby="works-title">
  <div class="section-heading">
    <div><p class="eyebrow">PROJECT ARCHIVE<span class="slash">/</span>專案作品</p><h2 id="works-title">精選現場</h2></div>
    <nav class="filters" aria-label="依類型瀏覽全部專案">
      <a class="filter current" href={url('works/')}>全部</a>{categories.map((c) => (<a class="filter" href={url(`works/?type=${c.key}`)}>{c.label}</a>))}
    </nav>
  </div>
  {lead && (
  <div class="works-grid">
    <article class="featured" data-reveal>
      <div class="project-media"><img class="featured-photo" src={asset(lead.data.cover)} alt={lead.data.coverAlt} width="1300" height="867" loading="lazy" decoding="async"></div>
      <div class="project-copy"><p class="project-type">{lead.data.category}｜{lead.data.year}</p><h3><a class="card-link" href={workUrl(lead)}>{lead.data.title}</a></h3>{lead.data.scope.length > 0 && <p class="project-scope">負責範圍｜{lead.data.scope.join('、')}</p>}</div>
    </article>
    <div class="work-list">
      {rest.map((w) => (
        <article class="work-row" data-reveal><div class="project-media"><img src={asset(w.data.cover)} alt={w.data.coverAlt} width="650" height="434" loading="lazy" decoding="async"></div><div class="project-copy"><p class="project-type">{w.data.category}｜{w.data.year}</p><h3><a class="card-link" href={workUrl(w)}>{w.data.title}</a></h3>{w.data.scope.length > 0 && <p class="project-scope">負責範圍｜{w.data.scope.join('、')}</p>}</div></article>
      ))}
    </div>
  </div>
  )}
  <div class="all-projects"><a class="text-link" href={url('works/')}>查看全部專案</a></div>
</section>
</div></div>
