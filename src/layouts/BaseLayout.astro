---
// 所有頁面共用的外框：<head> 設定、全站樣式、頁首、頁尾、浮動聯絡鈕、選單與動畫程式。
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactDock from '../components/ContactDock.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = '荖慕，開場！｜荖慕工作室有限公司',
  description = '荖慕工作室有限公司，活動企劃與執行、公關活動、文化藝術策展。',
} = Astro.props;
---
<!doctype html>
<html lang="zh-Hant">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content={description}>
  <meta name="theme-color" content="#ffffff">
  <title>{title}</title>
</head>
<body>
  <a class="skip-link" href="#main">跳至主要內容</a>
  <Header />
  <main id="main">
    <slot />
  </main>
  <Footer />
  <ContactDock />
  <script is:inline src={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/site.js`}></script>
</body>
</html>
